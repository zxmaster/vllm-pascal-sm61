# ============================================================================
# vLLM Pascal v0.31.0 — runtime + build configuration (upgrade from v0.28).
# Использование: VLLM_ENV_FILE=.env.v031 docker compose -f compose.sm61-v031.yaml up -d
# Сборка: SM61_ENV_FILE=.env.v031 ./scripts/build-sm61-source-cache.sh && ./scripts/build-sm61-image.sh
# ============================================================================

# --- модель ---
# fallback (Q4_K_M): MODEL_PATH=/models/Qwen3.5-4B-GGUF/Qwen3.5-4B-Q4_K_M.gguf
MODEL_PATH=/models/Qwen3.5-4B-IQ4_XS-GGUF/Qwen3.5-4B-IQ4_XS.gguf
SERVED_MODEL_NAME="Qwen3.5-4B-GGUF Qwen3.5-4B-IQ4_NL-GGUF"
TOKENIZER_MODEL=Qwen/Qwen3.5-4B
HF_CONFIG_PATH=/hf-configs/Qwen3.5-4B-text
REASONING_PARSER=qwen3

# --- runtime ---
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=1024
GPU_MEMORY_UTILIZATION=0.85
CPU_OFFLOAD_GB=0
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
IDLE_UNLOAD_TIMEOUT_SECONDS=1800
API_KEY=EMPTY
VLLM_EXTRA_ARGS=--language-model-only --dtype half --enable-auto-tool-choice --tool-call-parser qwen3_xml
VLLM_ENABLE_FLA_PACKED_RECURRENT_DECODE=0
# APC (automatic prefix caching): включено 04.10.2026 (ход deep research) — применится со следующего старта
ENABLE_PREFIX_CACHING=1
VLLM_PASCAL_TORCH_GDN=1
HF_HUB_OFFLINE=1

# --- нативный TurboQuant (v0.20+): OFF для первого подъёма, включить после
#     базовой валидации: turboquant_k3v4_nc (ближе всего к нашим 3/2 битам)
KV_CACHE_DTYPE=turboquant_k3v4_nc

# --- нативный DFlash: OFF для первого подъёма (драфт-модель в GGUF — проверяем)
DFLASH_ENABLE=0
DFLASH_DRAFT_MODEL=/models/Qwen3.5-4B-DFlash-GGUF/Qwen3.5-4B-DFlash-Q4_K_M.gguf
DFLASH_NUM_SPECULATIVE_TOKENS=1

# --- сборка (SM61_*) ---
# Torch для sm_61 собирается из исходников — это самая долгая часть сборки
# (часы). Артефакт в репозиторий не входит. Если у вас есть готовый
# sm_61-torch, положите его в artifacts/torch/site-packages/current/ и
# поставьте SM61_USE_TORCH_ARTIFACT=0.
IMAGE=local/vllm-openai:sm61-v031
SM61_SOURCE_CACHE_IMAGE=local/vllm-source-cache:sm61-v031
SM61_TORCH_REF=v2.13.0
SM61_VLLM_REF=v0.31.0
SM61_MAX_JOBS=4
SM61_GIT_SUBMODULE_JOBS=8
SM61_USE_TORCH_ARTIFACT=0
SM61_TORCH_ARTIFACT_SUBDIR=current
SM61_DOCKERFILE=docker/sm61/Dockerfile.v031
SM61_SOURCE_DOCKERFILE=docker/sm61/Dockerfile.sources-v031
PASCAL_GDN_DEBUG=0
